[Unit]
Description=LMI: ponowna próba pobierania, jeśli poranna się nie udała
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lmi
ExecStart=/usr/bin/docker compose run --rm -T app daily --if-needed
# 5.11: prywatne działki do Zimnych (plik w katalogu danych Leadów; błąd eksportu nie psuje przebiegu – „-”)
ExecStartPost=-/usr/bin/docker compose run --rm -T -v /opt/leady-dane:/eksport app zimne-dzialki --plik /eksport/dzialki-radar.json
TimeoutStartSec=12h
