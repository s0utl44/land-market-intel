[Unit]
Description=LMI: codzienny scraping Otodom + metryki
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lmi
ExecStart=/usr/bin/docker compose run --rm -T app daily
# pierwsze pełne pobranie trwa kilka godzin
TimeoutStartSec=12h
